# ==============================================================================
# NestHub TV Companion Dashboard - Environment Configuration
# ==============================================================================

# Server settings
PORT=8000
SECRET_KEY=change-this-to-a-secure-random-secret
DATABASE_URL=data/nestboard.db

# TV Companion settings
TV_FAMILY_ID=1

# Weather Configuration (Default: Ormond, Melbourne, VIC, Australia)
WEATHER_LAT=-37.9044
WEATHER_LON=145.0396
WEATHER_TIMEZONE=Australia/Melbourne
WEATHER_LOCATION_NAME="Ormond, Melbourne"

# Chromium Kiosk settings
NESHUB_DASHBOARD_URL=http://localhost:8000/dashboard
NESHUB_HEALTH_URL=http://localhost:8000/api/tv/summary
